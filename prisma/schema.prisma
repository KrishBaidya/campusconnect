// AluminX — Prisma schema (Prisma ORM 7, Supabase Postgres)
// Connection URLs live in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  student
  alumni

  @@map("user_role")
}

enum MentorshipStatus {
  pending
  accepted
  declined
  withdrawn

  @@map("mentorship_status")
}

enum ConnectionStatus {
  pending
  accepted
  declined

  @@map("connection_status")
}

enum PostKind {
  update
  opportunity
  referral
  project
  story

  @@map("post_kind")
}

enum PointReason {
  profile_complete
  connection
  quick_reply
  mentorship_accepted
  session_booked
  post

  @@map("point_reason")
}

model College {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  city     String?
  profiles Profile[]
  clubs    Club[]
  posts    Post[]

  @@map("colleges")
}

/// One row per Supabase Auth user. `id` is the same uuid as auth.users.id
/// (the foreign key to auth.users is added in the SQL migration, because
/// Prisma does not manage Supabase's `auth` schema).
model Profile {
  id           String    @id @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  role         UserRole?
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  avatarUrl    String?   @map("avatar_url")
  headline     String?
  /// short AI-written summary shown on the profile page
  bio          String?
  collegeId    String?   @map("college_id") @db.Uuid
  college      College?  @relation(fields: [collegeId], references: [id])
  department   String?
  batchYear    Int?      @map("batch_year")
  interests    String[]  @default([])
  expertise    String[]  @default([])
  /// e.g. "mentor", "referral", "cofounder", "investor"
  intents      String[]  @default([])
  /// e.g. {"days":["sat"],"hours":"18-20"}
  availability Json?
  achievements Json      @default("[]")
  githubUrl    String?   @map("github_url")
  githubUsername String? @map("github_username")
  linkedinUrl  String?   @map("linkedin_url")
  points       Int       @default(0)
  /// e.g. [{"name":"...","description":"...","url":"...","tech":["Next.js"]}]
  projects     Json      @default("[]")
  /// set when the user finishes onboarding (null = send them to /onboarding)
  onboardedAt  DateTime? @map("onboarded_at") @db.Timestamptz(6)
  /// mentorship sessions this person takes per calendar month
  mentorCapacity Int      @default(4) @map("mentor_capacity")
  /// weekly free blocks, "<day>-<slot>" (day 0 = Mon, slot 0 = morning .. 2 = evening)
  openBlocks     String[] @default([]) @map("open_blocks")

  experiences  Experience[]
  embedding    ProfileEmbedding?
  conversationsAsA Conversation[] @relation("ConversationUserA")
  conversationsAsB Conversation[] @relation("ConversationUserB")
  messagesSent     Message[]
  mentorshipsAsMentee MentorshipRequest[] @relation("MentorshipMentee")
  mentorshipsAsMentor MentorshipRequest[] @relation("MentorshipMentor")
  connectionsSent     Connection[]        @relation("ConnectionRequester")
  connectionsReceived Connection[]        @relation("ConnectionAddressee")
  posts               Post[]
  postLikes           PostLike[]
  clubs               ClubMember[]
  pointEvents         PointEvent[]

  @@index([collegeId])
  @@index([role])
  @@index([points])
  @@map("profiles")
}

/// Work history — one row per company, so alumni can have several.
model Experience {
  id        String    @id @default(uuid()) @db.Uuid
  profileId String    @map("profile_id") @db.Uuid
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company   String
  jobRole   String?   @map("job_role")
  startDate DateTime? @map("start_date") @db.Date
  /// null = current job
  endDate   DateTime? @map("end_date") @db.Date

  @@index([profileId])
  @@index([company])
  @@map("experiences")
}

/// One embedding per profile (pgvector). Prisma can't read or write the
/// `vector` type directly — use $queryRaw / $executeRaw or the match_profiles()
/// SQL function. 768 dims = Gemini gemini-embedding-001 with outputDimensionality: 768.
model ProfileEmbedding {
  profileId String                       @id @map("profile_id") @db.Uuid
  profile   Profile                      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(768)")?
  /// the text that was embedded — lets you re-embed when the profile changes
  source    String?
  updatedAt DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profile_embeddings")
}


/// A 1:1 direct-message thread. The pair is stored ordered (userA < userB)
/// so each pair has exactly one row — create it via the start_conversation()
/// SQL function. RLS + Realtime setup live in the 2_messages migration.
model Conversation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastMessageAt DateTime  @default(now()) @map("last_message_at") @db.Timestamptz(6)
  userAId       String    @map("user_a") @db.Uuid
  userA         Profile   @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId       String    @map("user_b") @db.Uuid
  userB         Profile   @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id") @db.Uuid
  sender         Profile      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  /// null = unread by the recipient
  readAt         DateTime?    @map("read_at") @db.Timestamptz(6)

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// A mentee asks a mentor for a session and proposes 1-3 times; the mentor
/// accepts one (scheduledAt) or declines. Constraints + RLS in 4_mentorship.
model MentorshipRequest {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  menteeId      String           @map("mentee_id") @db.Uuid
  mentee        Profile          @relation("MentorshipMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  mentorId      String           @map("mentor_id") @db.Uuid
  mentor        Profile          @relation("MentorshipMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  message       String
  proposedSlots DateTime[]       @map("proposed_slots") @db.Timestamptz(6)
  status        MentorshipStatus @default(pending)
  scheduledAt   DateTime?        @map("scheduled_at") @db.Timestamptz(6)
  declineReason String?          @map("decline_reason")
  respondedAt   DateTime?        @map("responded_at") @db.Timestamptz(6)

  @@index([mentorId, status])
  @@index([menteeId, status])
  @@map("mentorship_requests")
}

/// The "Connect" handshake. One row per pair (unique on the unordered pair in
/// SQL, see 5_network); the requester's personalised note is in `message`.
model Connection {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  requesterId String           @map("requester_id") @db.Uuid
  requester   Profile          @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String           @map("addressee_id") @db.Uuid
  addressee   Profile          @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      ConnectionStatus @default(pending)
  message     String?
  respondedAt DateTime?        @map("responded_at") @db.Timestamptz(6)

  @@index([requesterId, status])
  @@index([addresseeId, status])
  @@map("connections")
}

/// Feed posts. Stories are posts with kind = story and an expiry 24h out.
model Post {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  authorId  String     @map("author_id") @db.Uuid
  author    Profile    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// the author's college when posted, for the college-scoped feed
  collegeId String?    @map("college_id") @db.Uuid
  college   College?   @relation(fields: [collegeId], references: [id])
  kind      PostKind   @default(update)
  body      String
  linkUrl   String?    @map("link_url")
  /// for referrals and opportunities: company tag
  company   String?
  expiresAt DateTime?  @map("expires_at") @db.Timestamptz(6)
  likes     PostLike[]

  @@index([createdAt])
  @@index([collegeId, createdAt])
  @@index([authorId, createdAt])
  @@map("posts")
}

model PostLike {
  postId    String   @map("post_id") @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String   @map("profile_id") @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([postId, profileId])
  @@index([profileId])
  @@map("post_likes")
}

model Club {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String       @map("college_id") @db.Uuid
  college   College      @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  members   ClubMember[]

  @@unique([collegeId, name])
  @@map("clubs")
}

model ClubMember {
  clubId    String   @map("club_id") @db.Uuid
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  profileId String   @map("profile_id") @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  @@id([clubId, profileId])
  @@index([profileId])
  @@map("club_members")
}

/// Point ledger. A trigger adds each row to profiles.points; (profile, reason,
/// refId) is unique so one event never pays twice.
model PointEvent {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String      @map("profile_id") @db.Uuid
  profile   Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reason    PointReason
  points    Int
  refId     String      @map("ref_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([profileId, reason, refId])
  @@index([profileId, createdAt])
  @@map("point_events")
}
