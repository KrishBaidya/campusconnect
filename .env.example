# Postgres (Prisma) — Supabase → Project Settings → Database
DATABASE_URL=
DIRECT_URL=

# Supabase client (auth + messages + realtime) — Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gemini — profile generation + embeddings for matching (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional overrides (defaults: gemini-3.8-flash, gemini-embedding-001)
# GEMINI_MODEL=
# GEMINI_EMBED_MODEL=

# GitHub — optional; without it GitHub allows 60 API requests/hour per server IP
GITHUB_TOKEN=

# Public URL of the app, used to show the MCP server URL on the profile page
# (defaults to the request's host, e.g. http://localhost:3000)
# NEXT_PUBLIC_SITE_URL=https://aluminx.example.com
